# Select `openrouter` (default) or `openai`.
DISPUTE_MODEL_PROVIDER=openrouter

# OpenRouter uses an OpenAI-compatible API. Keep this key in .env only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-8b
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=olist-dispute-resolution
OPENROUTER_TIMEOUT_SECONDS=30

# Direct OpenAI API option. Used only when DISPUTE_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# Set false only for local deterministic development without API calls.
DISPUTE_ENABLE_MODEL_AUDIT=true
DISPUTE_STRICT_MODEL_AUDIT=false
DISPUTE_MAX_WORKERS=3
DISPUTE_RUNTIME=python-3.13
